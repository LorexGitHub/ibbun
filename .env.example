# The host port Compose maps Postgres to. Change both lines if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://ibbun:ibbun@localhost:5432/ibbun
# The API can run as the app role, as on Aurora: postgres://ibbun_app:ibbun_app@localhost:5432/ibbun
# On AWS, DATABASE_IAM_REGION turns on IAM tokens and TLS, and DATABASE_POOL_MAX sets the pool (1 or 2 per Lambda).
API_PORT=3000
# The SQS queue every job goes to: ElasticMQ in Compose.
JOBS_QUEUE_URL=http://localhost:9324/000000000000/ibbun-jobs
SUDACHI_URL=http://localhost:8000
# On AWS this is the VOICEVOX Lambda's function URL; calls to it are signed with the role's AWS_* credentials.
VOICEVOX_URL=http://localhost:50021
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5173
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
SEED_LEARNER_PASSWORD=learner-password
SEED_SUPERVISOR_PASSWORD=supervisor-password
# Where the import slice keeps the raw upstream files of the last 3 runs per dataset (a Docker volume in Compose).
IMPORT_RAW_DIR=./data/import-raw
# AUDIO_DIR and IMPORT_RAW_DIR also take s3://bucket/prefix. Against Compose's S3 (`docker compose up -d s3`):
# AWS_ENDPOINT_URL_S3=http://localhost:8333
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# Content generation and review (ADR 0016). Unset, LLM_PROVIDER is the Anthropic API (ANTHROPIC_API_KEY).
# Locally without a key: gemma4:12b on Ollama drafts, Claude through `claude -p` reviews.
# LLM_PROVIDER=ollama,claude-code
# LLM_GENERATOR_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434
