# The host port Compose maps Postgres to. Change both lines if 5432 is taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://ibbun:ibbun@localhost:5432/ibbun
# The API can run as the app role, as on Aurora: postgres://ibbun_app:ibbun_app@localhost:5432/ibbun
# On AWS, DATABASE_IAM_REGION turns on IAM tokens and TLS, and DATABASE_POOL_MAX sets the pool (1 or 2 per Lambda).
API_PORT=3000
SUDACHI_URL=http://localhost:8000
VOICEVOX_URL=http://localhost:50021
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5173
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
SEED_LEARNER_PASSWORD=learner-password
SEED_SUPERVISOR_PASSWORD=supervisor-password
# Where the import slice keeps the raw upstream files of the last 3 runs per dataset (a Docker volume in Compose).
IMPORT_RAW_DIR=./data/import-raw
