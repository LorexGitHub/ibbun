{
  "name": "ibbun",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "node scripts/gen-slice-index.mjs",
    "dev": "pnpm gen && pnpm -r --parallel --filter \"./apps/*\" dev",
    "db:migrate": "pnpm --filter @ibbun/db migrate",
    "content:import": "node --env-file-if-exists=.env slices/import/server/import-cli.ts",
    "content:examples": "node --env-file-if-exists=.env slices/import/server/examples-cli.ts",
    "content:publish": "node --env-file-if-exists=.env slices/import/server/publish-cli.ts",
    "test":"pnpm gen && vitest run",
    "typecheck": "pnpm gen && tsc -p . && tsc -p apps/web",
    "test:packages": "pnpm gen && node scripts/gates/vitest-per-package.ts",
    "depcruise": "node scripts/gates/depcruise.ts",
    "gate:dryer": "node scripts/gates/dryer.ts",
    "gate:mutator": "node scripts/gates/mutator.ts",
    "e2e": "pnpm gen && playwright test"
  },
  "devDependencies": {
    "@ibbun/jobs": "workspace:*",
    "@ibbun/slice": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "^17.4.3",
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
